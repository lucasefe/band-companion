{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "band-companion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "band-companion-audio"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  // Default key for becoming the leader. Override without committing:
  //   npx wrangler secret put LEADER_KEY
  "vars": {
    "LEADER_KEY": "goodkarma"
  },
  "observability": {
    "enabled": true
  }
}
